# Internal auth (shared with Express)
INTERNAL_TOKEN=change-me-to-a-strong-secret

# MongoDB
MONGO_URI=mongodb://localhost:27017
MONGO_DB=smart_cloud_dms

# AWS S3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET=smart-cloud-dms

# ─── AI Provider ───────────────────────────────────
# Options: gemini (free tier) | openai | azure
AI_PROVIDER=gemini

# Google Gemini (FREE — default for personal projects)
# Get your key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-2.0-flash
GEMINI_EMBED_MODEL=text-embedding-004

# OpenAI (paid — uncomment and set AI_PROVIDER=openai to use)
# OPENAI_API_KEY=
# OPENAI_EMBED_MODEL=text-embedding-3-small
# OPENAI_CHAT_MODEL=gpt-4o-mini

# Azure OpenAI (paid — uncomment and set AI_PROVIDER=azure to use)
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
# AZURE_OPENAI_API_VERSION=2024-06-01
# AZURE_OPENAI_EMBED_DEPLOYMENT=text-embedding-3-small
# AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4o-mini

# Retrieval tuning
RAG_TOP_K=10
RAG_SIMILARITY_THRESHOLD=0.70
CHUNK_MIN_TOKENS=500
CHUNK_MAX_TOKENS=800

# App
LOG_LEVEL=INFO
ALLOWED_ORIGINS=*
